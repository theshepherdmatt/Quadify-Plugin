[Unit]
Description=Quadify early boot LED indicator (LED2)
# Light the boot indicator as early as physically possible — before the OLED
# splash and the main app — so the unit visibly shows life the instant it powers
# on. Runs under sysinit; the script retries until the I2C bus is ready.
DefaultDependencies=no
RequiresMountsFor=/data
After=systemd-modules-load.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /data/plugins/system_hardware/quadify/quadifyapp/scripts/early_led8.py
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15

[Install]
WantedBy=sysinit.target
